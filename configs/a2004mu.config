CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_iptime_a2004mu=y
CONFIG_DRIVER_11AC_SUPPORT=y
