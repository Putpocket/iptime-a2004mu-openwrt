--- /dev/null
+++ b/target/linux/realtek/patches-6.18/301-mips-realtek-add-rtl8197f-kconfig-scaffold.patch
@@ -0,0 +1,27 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: A2004MU OpenWrt Research <noreply@example.invalid>
+Date: Mon, 29 Jun 2026 00:00:00 +0900
+Subject: [PATCH] mips: realtek: add RTL8197F Kconfig scaffold
+
+Add a provisional RTL8197F Kconfig symbol under the existing Realtek MIPS
+machine family. This is a clean-room scaffold only and is not hardware
+validated.
+
+This deliberately does not select RTL838X, RTL839X, RTL930X, or RTL931X, and
+does not add register, IRQ, clock, timer, or driver assumptions.
+---
+--- a/arch/mips/Kconfig
++++ b/arch/mips/Kconfig
+@@ -1086,6 +1086,12 @@ config RTL931X
+ 	select SYS_SUPPORTS_SMP
+ 	select SYS_SUPPORTS_MIPS_CPS
+ 
++config MACH_REALTEK_RTL8197F
++	bool "Realtek RTL8197F scaffold"
++	depends on MACH_REALTEK_RTL
++	help
++	  Clean-room scaffold only; not hardware validated.
++
+ source "arch/mips/alchemy/Kconfig"
+ source "arch/mips/ath25/Kconfig"
+ source "arch/mips/ath79/Kconfig"
diff --git a/target/linux/realtek/patches-6.18/302-watchdog-add-rtl8197f-watchdog-scaffold.patch b/target/linux/realtek/patches-6.18/302-watchdog-add-rtl8197f-watchdog-scaffold.patch
new file mode 100644
index 0000000000..f20ec0dc63
--- /dev/null
+++ b/target/linux/realtek/patches-6.18/302-watchdog-add-rtl8197f-watchdog-scaffold.patch
@@ -0,0 +1,76 @@
+--- a/drivers/watchdog/Kconfig
++++ b/drivers/watchdog/Kconfig
+@@ -1088,6 +1088,20 @@ config REALTEK_OTTO_WDT
+ 
+ 	  When built as a module this will be called realtek_otto_wdt.
+ 
++config RTL8197F_WDT
++	tristate "Realtek RTL8197F watchdog scaffold"
++	depends on MACH_REALTEK_RTL8197F || COMPILE_TEST
++	depends on OF
++	help
++	  Clean-room scaffold for RTL8197F watchdog investigation.
++
++	  This driver intentionally does not access MMIO registers or register
++	  a watchdog device until the RTL8197F watchdog register map is verified
++	  from license-compatible public evidence or clean-room observation.
++
++	  If built, probe returns -ENODEV and logs that the hardware register map
++	  is unresolved. Do not use this as operational watchdog support.
++
+ config SPRD_WATCHDOG
+ 	tristate "Spreadtrum watchdog support"
+ 	depends on ARCH_SPRD || COMPILE_TEST
+--- a/drivers/watchdog/Makefile
++++ b/drivers/watchdog/Makefile
+@@ -185,6 +185,7 @@ obj-$(CONFIG_RTD119X_WATCHDOG) += rtd119x_wdt.o
+ obj-$(CONFIG_SPRD_WATCHDOG) += sprd_wdt.o
+ obj-$(CONFIG_PM8916_WATCHDOG) += pm8916_wdt.o
+ obj-$(CONFIG_REALTEK_OTTO_WDT) += realtek_otto_wdt.o
++obj-$(CONFIG_RTL8197F_WDT) += rtl8197f_wdt.o
+ 
+ # PARISC Architecture
+ 
+--- /dev/null
++++ b/drivers/watchdog/rtl8197f_wdt.c
+@@ -0,0 +1,40 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Clean-room RTL8197F watchdog scaffold.
++ *
++ * This file deliberately avoids register definitions, MMIO access, and
++ * watchdog registration until the RTL8197F watchdog register map is verified
++ * from license-compatible public evidence or clean-room observation.
++ */
++
++#include <linux/errno.h>
++#include <linux/module.h>
++#include <linux/mod_devicetable.h>
++#include <linux/platform_device.h>
++
++static int rtl8197f_wdt_probe(struct platform_device *pdev)
++{
++	dev_warn(&pdev->dev,
++		 "RTL8197F watchdog scaffold disabled: register map unresolved\n");
++
++	return -ENODEV;
++}
++
++static const struct of_device_id rtl8197f_wdt_of_match[] = {
++	{ .compatible = "realtek,rtl8197f-watchdog" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, rtl8197f_wdt_of_match);
++
++static struct platform_driver rtl8197f_wdt_driver = {
++	.probe = rtl8197f_wdt_probe,
++	.driver = {
++		.name = "rtl8197f-wdt",
++		.of_match_table = rtl8197f_wdt_of_match,
++	},
++};
++module_platform_driver(rtl8197f_wdt_driver);
++
++MODULE_AUTHOR("OpenWrt A2004MU clean-room scaffold");
++MODULE_DESCRIPTION("RTL8197F watchdog scaffold without hardware access");
++MODULE_LICENSE("GPL");
diff --git a/target/linux/realtek/patches-6.18/717-net-add-rtl8197f-ethernet-scaffold.patch b/target/linux/realtek/patches-6.18/717-net-add-rtl8197f-ethernet-scaffold.patch
new file mode 100644
index 0000000000..21737407e1
--- /dev/null
+++ b/target/linux/realtek/patches-6.18/717-net-add-rtl8197f-ethernet-scaffold.patch
@@ -0,0 +1,391 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: A2004MU Clean-room Scaffold <noreply@example.invalid>
+Date: Tue, 30 Jun 2026 00:00:00 +0900
+Subject: [PATCH] net: ethernet: add RTL8197F Ethernet scaffold
+
+Add a clean-room RTL8197F Ethernet driver scaffold symbol and platform
+netdev path. The driver can bind only when DTS supplies MMIO and IRQ
+resources, but it still avoids MDIO, DMA, TX/RX register programming, and
+switch setup until those facts are independently verified.
+---
+ drivers/net/ethernet/Kconfig        | 16 ++++++--
+ drivers/net/ethernet/Makefile       |  1 +
+ drivers/net/ethernet/rtl8197f_eth.c | 338 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ 3 files changed, 355 insertions(+), 4 deletions(-)
+ create mode 100644 drivers/net/ethernet/rtl8197f_eth.c
+
+--- a/drivers/net/ethernet/Kconfig
++++ b/drivers/net/ethernet/Kconfig
+@@ -187,6 +187,21 @@ config NET_RTL838X
+ 	help
+ 	  Say Y here if you want to use the Realtek rtl838x Gbps Ethernet MAC.
+ 
++config RTL8197F_ETH
++	tristate "Realtek RTL8197F Ethernet scaffold"
++	depends on MACH_REALTEK_RTL8197F || COMPILE_TEST
++	depends on OF
++	select MII
++	help
++	  Clean-room scaffold for RTL8197F Ethernet investigation.
++
++	  This driver separates RTL8197F Ethernet from the RTL838x/Otto path
++	  and provides a minimal platform net_device skeleton. It does not
++	  program DMA, MDIO, PHY, switch, or packet datapath registers until
++	  those hardware facts are verified from license-compatible evidence.
++
++	  If unsure, say N.
++
+ source "drivers/net/ethernet/samsung/Kconfig"
+ source "drivers/net/ethernet/seeq/Kconfig"
+ source "drivers/net/ethernet/sgi/Kconfig"
+--- a/drivers/net/ethernet/Makefile
++++ b/drivers/net/ethernet/Makefile
+@@ -84,6 +84,7 @@ obj-$(CONFIG_NET_VENDOR_RENESAS) += rene
+ obj-$(CONFIG_NET_VENDOR_RDC) += rdc/
+ obj-$(CONFIG_NET_VENDOR_ROCKER) += rocker/
+ obj-$(CONFIG_NET_RTL838X) += rtl838x_eth.o
++obj-$(CONFIG_RTL8197F_ETH) += rtl8197f_eth.o
+ obj-$(CONFIG_NET_VENDOR_SAMSUNG) += samsung/
+ obj-$(CONFIG_NET_VENDOR_SEEQ) += seeq/
+ obj-$(CONFIG_NET_VENDOR_SILAN) += silan/
+--- /dev/null
++++ b/drivers/net/ethernet/rtl8197f_eth.c
+@@ -0,0 +1,338 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Clean-room RTL8197F Ethernet driver.
++ *
++ * This driver keeps RTL8197F separate from the RTL838x/RTL93xx/Otto Ethernet
++ * path. The DMA ring model is derived from GPL-2.0 Realtek rtl865x software
++ * NIC sources, but register offsets, descriptor ABI details, MDIO operations,
++ * and switch setup are intentionally not copied from non-GPL headers. Until a
++ * license-compatible register map is available, the driver allocates the
++ * netdev and DMA resources but refuses to start the datapath.
++ */
++
++#include <linux/bitops.h>
++#include <linux/dma-mapping.h>
++#include <linux/etherdevice.h>
++#include <linux/interrupt.h>
++#include <linux/io.h>
++#include <linux/module.h>
++#include <linux/mod_devicetable.h>
++#include <linux/netdevice.h>
++#include <linux/platform_device.h>
++#include <linux/skbuff.h>
++
++#define RTL8197F_ETH_TX_DESC_NUM	128
++#define RTL8197F_ETH_RX_DESC_NUM	256
++#define RTL8197F_ETH_RX_BUF_SIZE	2048
++
++/* Clean-room descriptor placeholder: not written to hardware yet. */
++#define RTL8197F_DESC_HW_OWN		BIT(0)
++#define RTL8197F_DESC_WRAP		BIT(1)
++
++struct rtl8197f_eth_desc {
++	__le32 addr;
++	__le32 length;
++	__le32 flags;
++	__le32 reserved;
++};
++
++struct rtl8197f_eth_priv {
++	struct net_device *ndev;
++	struct napi_struct napi;
++	void __iomem *base;
++	int irq;
++
++	struct rtl8197f_eth_desc *tx_ring;
++	dma_addr_t tx_ring_dma;
++	struct rtl8197f_eth_desc *rx_ring;
++	dma_addr_t rx_ring_dma;
++	struct sk_buff *rx_skb[RTL8197F_ETH_RX_DESC_NUM];
++	dma_addr_t rx_dma[RTL8197F_ETH_RX_DESC_NUM];
++
++	bool rings_ready;
++	bool datapath_ready;
++};
++
++static void rtl8197f_eth_free_rings(struct net_device *ndev)
++{
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++	struct device *dev = ndev->dev.parent;
++	unsigned int i;
++
++	for (i = 0; i < RTL8197F_ETH_RX_DESC_NUM; i++) {
++		if (!priv->rx_skb[i])
++			continue;
++
++		dma_unmap_single(dev, priv->rx_dma[i], RTL8197F_ETH_RX_BUF_SIZE,
++				 DMA_FROM_DEVICE);
++		dev_kfree_skb_any(priv->rx_skb[i]);
++		priv->rx_skb[i] = NULL;
++		priv->rx_dma[i] = 0;
++	}
++
++	if (priv->rx_ring) {
++		dma_free_coherent(dev, sizeof(*priv->rx_ring) *
++				  RTL8197F_ETH_RX_DESC_NUM, priv->rx_ring,
++				  priv->rx_ring_dma);
++		priv->rx_ring = NULL;
++		priv->rx_ring_dma = 0;
++	}
++
++	if (priv->tx_ring) {
++		dma_free_coherent(dev, sizeof(*priv->tx_ring) *
++				  RTL8197F_ETH_TX_DESC_NUM, priv->tx_ring,
++				  priv->tx_ring_dma);
++		priv->tx_ring = NULL;
++		priv->tx_ring_dma = 0;
++	}
++
++	priv->rings_ready = false;
++}
++
++static int rtl8197f_eth_alloc_rings(struct net_device *ndev)
++{
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++	struct device *dev = ndev->dev.parent;
++	unsigned int i;
++	__le32 flags;
++
++	if (priv->rings_ready)
++		return 0;
++
++	priv->tx_ring = dma_alloc_coherent(dev, sizeof(*priv->tx_ring) *
++					RTL8197F_ETH_TX_DESC_NUM,
++					&priv->tx_ring_dma, GFP_KERNEL);
++	if (!priv->tx_ring)
++		return -ENOMEM;
++
++	priv->rx_ring = dma_alloc_coherent(dev, sizeof(*priv->rx_ring) *
++					RTL8197F_ETH_RX_DESC_NUM,
++					&priv->rx_ring_dma, GFP_KERNEL);
++	if (!priv->rx_ring) {
++		rtl8197f_eth_free_rings(ndev);
++		return -ENOMEM;
++	}
++
++	for (i = 0; i < RTL8197F_ETH_RX_DESC_NUM; i++) {
++		struct sk_buff *skb;
++		dma_addr_t dma;
++
++		skb = netdev_alloc_skb(ndev, RTL8197F_ETH_RX_BUF_SIZE);
++		if (!skb) {
++			rtl8197f_eth_free_rings(ndev);
++			return -ENOMEM;
++		}
++
++		dma = dma_map_single(dev, skb->data, RTL8197F_ETH_RX_BUF_SIZE,
++				     DMA_FROM_DEVICE);
++		if (dma_mapping_error(dev, dma)) {
++			dev_kfree_skb_any(skb);
++			rtl8197f_eth_free_rings(ndev);
++			return -ENOMEM;
++		}
++
++		priv->rx_skb[i] = skb;
++		priv->rx_dma[i] = dma;
++		priv->rx_ring[i].addr = cpu_to_le32(lower_32_bits(dma));
++		priv->rx_ring[i].length = cpu_to_le32(RTL8197F_ETH_RX_BUF_SIZE);
++
++		flags = cpu_to_le32(RTL8197F_DESC_HW_OWN);
++		if (i == RTL8197F_ETH_RX_DESC_NUM - 1)
++			flags |= cpu_to_le32(RTL8197F_DESC_WRAP);
++		priv->rx_ring[i].flags = flags;
++	}
++
++	for (i = 0; i < RTL8197F_ETH_TX_DESC_NUM; i++) {
++		flags = 0;
++		if (i == RTL8197F_ETH_TX_DESC_NUM - 1)
++			flags |= cpu_to_le32(RTL8197F_DESC_WRAP);
++		priv->tx_ring[i].flags = flags;
++	}
++
++	priv->rings_ready = true;
++
++	return 0;
++}
++
++static int rtl8197f_eth_hw_start(struct net_device *ndev)
++{
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++
++	if (!priv->datapath_ready) {
++		netdev_warn(ndev,
++			    "MAC/MDIO register map unresolved; datapath disabled\n");
++		return -EOPNOTSUPP;
++	}
++
++	return 0;
++}
++
++static int rtl8197f_eth_poll(struct napi_struct *napi, int budget)
++{
++	struct rtl8197f_eth_priv *priv = container_of(napi,
++						       struct rtl8197f_eth_priv, napi);
++
++	if (!priv->datapath_ready) {
++		napi_complete_done(napi, 0);
++		return 0;
++	}
++
++	napi_complete_done(napi, 0);
++
++	return 0;
++}
++
++static int rtl8197f_eth_open(struct net_device *ndev)
++{
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++	int err;
++
++	err = rtl8197f_eth_alloc_rings(ndev);
++	if (err)
++		return err;
++
++	err = rtl8197f_eth_hw_start(ndev);
++	if (err) {
++		rtl8197f_eth_free_rings(ndev);
++		return err;
++	}
++
++	napi_enable(&priv->napi);
++	netif_start_queue(ndev);
++	netif_carrier_on(ndev);
++
++	return 0;
++}
++
++static int rtl8197f_eth_stop(struct net_device *ndev)
++{
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++
++	netif_carrier_off(ndev);
++	netif_stop_queue(ndev);
++	napi_disable(&priv->napi);
++	rtl8197f_eth_free_rings(ndev);
++
++	return 0;
++}
++
++static netdev_tx_t rtl8197f_eth_start_xmit(struct sk_buff *skb,
++						   struct net_device *ndev)
++{
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++
++	if (!priv->datapath_ready) {
++		netif_stop_queue(ndev);
++		netdev_warn_once(ndev,
++				 "TX registers unresolved; queue stopped\n");
++		return NETDEV_TX_BUSY;
++	}
++
++	return NETDEV_TX_BUSY;
++}
++
++static const struct net_device_ops rtl8197f_eth_netdev_ops = {
++	.ndo_open		= rtl8197f_eth_open,
++	.ndo_stop		= rtl8197f_eth_stop,
++	.ndo_start_xmit		= rtl8197f_eth_start_xmit,
++	.ndo_set_mac_address	= eth_mac_addr,
++	.ndo_validate_addr	= eth_validate_addr,
++};
++
++static irqreturn_t rtl8197f_eth_irq(int irq, void *data)
++{
++	struct net_device *ndev = data;
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++
++	if (!priv->datapath_ready) {
++		netdev_warn_once(ndev,
++				 "IRQ asserted before interrupt registers are implemented\n");
++		return IRQ_NONE;
++	}
++
++	napi_schedule(&priv->napi);
++
++	return IRQ_HANDLED;
++}
++
++static int rtl8197f_eth_probe(struct platform_device *pdev)
++{
++	struct rtl8197f_eth_priv *priv;
++	struct net_device *ndev;
++	int err;
++
++	ndev = devm_alloc_etherdev(&pdev->dev, sizeof(*priv));
++	if (!ndev)
++		return -ENOMEM;
++
++	priv = netdev_priv(ndev);
++	priv->ndev = ndev;
++	platform_set_drvdata(pdev, ndev);
++	SET_NETDEV_DEV(ndev, &pdev->dev);
++
++	priv->base = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(priv->base))
++		return dev_err_probe(&pdev->dev, PTR_ERR(priv->base),
++				     "missing RTL8197F Ethernet MMIO resource\n");
++
++	priv->irq = platform_get_irq_optional(pdev, 0);
++	if (priv->irq == -ENXIO)
++		return dev_err_probe(&pdev->dev, priv->irq,
++				     "missing RTL8197F Ethernet IRQ resource\n");
++	if (priv->irq < 0)
++		return dev_err_probe(&pdev->dev, priv->irq,
++				     "failed to read RTL8197F Ethernet IRQ\n");
++
++	err = devm_request_irq(&pdev->dev, priv->irq, rtl8197f_eth_irq, 0,
++			       dev_name(&pdev->dev), ndev);
++	if (err)
++		return dev_err_probe(&pdev->dev, err,
++				     "failed to request RTL8197F Ethernet IRQ\n");
++
++	ndev->netdev_ops = &rtl8197f_eth_netdev_ops;
++	netif_napi_add_weight(ndev, &priv->napi, rtl8197f_eth_poll, 64);
++	netif_carrier_off(ndev);
++	eth_hw_addr_random(ndev);
++
++	err = register_netdev(ndev);
++	if (err) {
++		netif_napi_del(&priv->napi);
++		return dev_err_probe(&pdev->dev, err,
++				     "failed to register RTL8197F Ethernet netdev\n");
++	}
++
++	netdev_warn(ndev,
++		    "registered; DMA rings prepared but MAC/MDIO datapath disabled\n");
++
++	return 0;
++}
++
++static void rtl8197f_eth_remove(struct platform_device *pdev)
++{
++	struct net_device *ndev = platform_get_drvdata(pdev);
++	struct rtl8197f_eth_priv *priv = netdev_priv(ndev);
++
++	unregister_netdev(ndev);
++	netif_napi_del(&priv->napi);
++	rtl8197f_eth_free_rings(ndev);
++}
++
++static const struct of_device_id rtl8197f_eth_of_match[] = {
++	{ .compatible = "realtek,rtl8197f-ethernet" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, rtl8197f_eth_of_match);
++
++static struct platform_driver rtl8197f_eth_driver = {
++	.probe = rtl8197f_eth_probe,
++	.remove = rtl8197f_eth_remove,
++	.driver = {
++		.name = "rtl8197f-eth",
++		.of_match_table = rtl8197f_eth_of_match,
++	},
++};
++module_platform_driver(rtl8197f_eth_driver);
++
++MODULE_AUTHOR("A2004MU clean-room port");
++MODULE_DESCRIPTION("RTL8197F Ethernet netdev driver");
++MODULE_LICENSE("GPL");
