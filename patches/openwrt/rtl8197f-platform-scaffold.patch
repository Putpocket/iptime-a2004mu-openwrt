new file mode 100644
index 0000000000..e313199b1a
--- /dev/null
+++ b/target/linux/realtek/rtl8197f/README.md
@@ -0,0 +1,35 @@
+# RTL8197F Scaffold
+
+This is a clean-room scaffold for RTL8197F investigation.
+
+Status:
+
+* Not hardware validated.
+* Not a complete OpenWrt target.
+* No flash/install instructions.
+* No SDK vendor code.
+* No generated firmware output.
+
+Required unknowns:
+
+* CPU/platform compatibility.
+* Machine compatible.
+* Memory map.
+* UART base/IRQ/clock.
+* Interrupt controller.
+* Timer/clocksource.
+* SPI NOR controller.
+* Ethernet MAC.
+* Switch/PHY/MDIO.
+* GPIO/LED/button.
+* Image recipe.
+
+First milestone:
+
+* Kernel boot log over UART.
+* Then wired LAN + SSH.
+
+Deferred:
+
+* Wi-Fi.
+* LuCI.
diff --git a/target/linux/realtek/rtl8197f/config-6.18 b/target/linux/realtek/rtl8197f/config-6.18
new file mode 100644
index 0000000000..dcfa9b3ae8
--- /dev/null
+++ b/target/linux/realtek/rtl8197f/config-6.18
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Clean-room RTL8197F scaffold only.
+#
+# TODO: Add only independently verified kernel config symbols after the
+# CPU/platform, timer, interrupt, UART, SPI NOR, Ethernet MAC, and switch/PHY
+# paths are confirmed. Do not copy SDK-derived config.
+CONFIG_COMPAT_32BIT_TIME=y
+CONFIG_COMMON_CLK=y
+# Existing realtek subtargets all enable the generic common clock framework, but
+# only some enable Realtek-specific RTL83xx clock drivers. RTL8197F clock driver
+# compatibility is not confirmed.
+# CONFIG_COMMON_CLK_REALTEK is not set
+CONFIG_PAGE_BLOCK_MAX_ORDER=10
+CONFIG_MACH_REALTEK_RTL=y
+CONFIG_MACH_REALTEK_RTL8197F=y
+# Stock A2004MU UART log reports: CPU revision is 00019385 (MIPS 24Kc).
+# MIPS 24Kc is a MIPS32 Release 2 core.
+# CONFIG_CPU_MIPS32_R1 is not set
+CONFIG_CPU_MIPS32_R2=y
+# Existing target/linux/realtek subtargets enable early 8250 printk.
+CONFIG_EARLY_PRINTK=y
+CONFIG_EARLY_PRINTK_8250=y
+CONFIG_SYS_HAS_EARLY_PRINTK=y
+CONFIG_USE_GENERIC_EARLY_PRINTK_8250=y
+# Existing target/linux/realtek subtargets use raw appended DTB. This follows
+# the target convention only; the A2004MU DTS remains a scaffold.
+# CONFIG_MIPS_NO_APPENDED_DTB is not set
+CONFIG_MIPS_RAW_APPENDED_DTB=y
+# Existing target/linux/realtek subtargets take kernel arguments from DTB.
+# CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER is not set
+CONFIG_MIPS_CMDLINE_FROM_DTB=y
+# Stock A2004MU boot evidence reports an 8 MB xmc25qh64 SPI NOR on m25p80.
+# Existing non-NAND realtek subtargets disable Realtek NAND ECC/SPI NAND and
+# enable the SPI NOR stack.
+# CONFIG_MTD_NAND_ECC_REALTEK is not set
+CONFIG_MTD_SPI_NOR=y
+CONFIG_SPI=y
+CONFIG_SPI_MASTER=y
+CONFIG_SPI_MEM=y
+# CONFIG_SPI_REALTEK_SNAND is not set
+# The existing OpenWrt realtek Ethernet MAC driver is RTL838x/RTL83xx/RTL93xx
+# oriented. A2004MU stock logs prove Ethernet exists, but not RTL838x MAC
+# compatibility.
+# CONFIG_NET_RTL838X is not set
+# Existing OpenWrt realtek subtargets use the Realtek Otto SerDes PCS driver.
+# No A2004MU evidence currently proves RTL8197F uses that PCS path.
+# CONFIG_PCS_RTL_OTTO is not set
+CONFIG_RTL8197F_ETH=y
+CONFIG_MDIO_BUS=y
+CONFIG_MDIO_DEVICE=y
+CONFIG_PHYLIB=y
+CONFIG_NET_VENDOR_REALTEK=y
+CONFIG_ETHERNET=y
+CONFIG_NETDEVICES=y
+# No A2004MU evidence currently proves an RTL8214x/RTL8218x multiport PHY.
+# CONFIG_REALTEK_PHY_MULTIPORT is not set
+# CONFIG_REALTEK_PHY is not set
+# Existing Realtek RTL9300/Otto MDIO support is not proven for RTL8197F.
+# CONFIG_MDIO_REALTEK_RTL9300 is not set
+# CONFIG_MDIO_REALTEK_OTTO is not set
+# CONFIG_MDIO_REALTEK_OTTO_SERDES is not set
+# Stock logs prove RTL8197F has GPIO, but not compatibility with the existing
+# Realtek Otto GPIO driver. LEDs/buttons are deferred.
+# CONFIG_GPIO_REALTEK_OTTO is not set
+# Existing realtek switch boards may use RTL8231 GPIO/LED expanders. No A2004MU
+# evidence currently shows an RTL8231, and LEDs/buttons are deferred.
+# CONFIG_LEDS_RTL8231 is not set
+# CONFIG_MFD_RTL8231 is not set
+# CONFIG_PINCTRL_RTL8231 is not set
+# Existing Realtek Otto watchdog support is tied to RTL83xx/RTL93xx-compatible
+# DTS paths. This is a compile-only workaround; RTL8197F watchdog handling is a
+# boot-risk blocker until independently implemented.
+# CONFIG_REALTEK_OTTO_WDT is not set
+CONFIG_RTL8197F_WDT=y
+# CONFIG_RTL838X is not set
+# CONFIG_RTL839X is not set
+# CONFIG_RTL930X is not set
+# CONFIG_RTL931X is not set
