diff --git a/target/linux/rtl819x/patches-6.18/020-irqchip-add-realtek-rtl8197f-ictl-scaffold.patch b/target/linux/rtl819x/patches-6.18/020-irqchip-add-realtek-rtl8197f-ictl-scaffold.patch
new file mode 100644
index 0000000000000000000000000000000000000000..04666ccfe366fa0d2b6d88b3c073d4a0a1d8666a
--- /dev/null
+++ b/target/linux/rtl819x/patches-6.18/020-irqchip-add-realtek-rtl8197f-ictl-scaffold.patch
@@ -0,0 +1,211 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: OpenWrt RTL8197F scaffold <noreply@example.invalid>
+Date: Tue, 7 Jul 2026 00:00:00 +0900
+Subject: [PATCH] irqchip: add Realtek RTL8197F ICTL scaffold
+
+Add a minimal irqchip driver scaffold for the RTL8197F interrupt controller.
+Routing constants are intentionally left as TODOs until the kernel 6.x binding
+is finalized.
+
+---
+ drivers/irqchip/Kconfig                |   6 +
+ drivers/irqchip/Makefile               |   1 +
+ drivers/irqchip/irq-realtek-rtl8197f.c | 166 +++++++++++++++++++++++++
+ 3 files changed, 173 insertions(+)
+ create mode 100644 drivers/irqchip/irq-realtek-rtl8197f.c
+
+--- a/drivers/irqchip/Kconfig
++++ b/drivers/irqchip/Kconfig
+@@ -230,6 +230,12 @@ config IRQ_MIPS_CPU
+ 	select GENERIC_IRQ_CHIP
+ 	select IRQ_DOMAIN
+
++config IRQ_REALTEK_RTL8197F
++	bool "Realtek RTL8197F interrupt controller scaffold"
++	depends on MACH_REALTEK_RTL819X
++	select IRQ_DOMAIN
++	select GENERIC_IRQ_CHIP
++
+ config CLPS711X_IRQCHIP
+ 	bool
+ 	select IRQ_DOMAIN
+--- a/drivers/irqchip/Makefile
++++ b/drivers/irqchip/Makefile
+@@ -53,6 +53,7 @@ obj-$(CONFIG_IMGPDC_IRQ)		+= irq-imgpdc.o
+ obj-$(CONFIG_IRQ_MIPS_CPU)		+= irq-mips-cpu.o
+ obj-$(CONFIG_IXP4XX_IRQ)		+= irq-ixp4xx.o
+ obj-$(CONFIG_JCORE_AIC)			+= irq-jcore-aic.o
++obj-$(CONFIG_IRQ_REALTEK_RTL8197F)	+= irq-realtek-rtl8197f.o
+ obj-$(CONFIG_RDA_INTC)			+= irq-rda-intc.o
+ obj-$(CONFIG_RENESAS_INTC_IRQPIN)	+= irq-renesas-intc-irqpin.o
+ obj-$(CONFIG_RENESAS_IRQC)		+= irq-renesas-irqc.o
+--- /dev/null
++++ b/drivers/irqchip/irq-realtek-rtl8197f.c
+@@ -0,0 +1,167 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Realtek RTL8197F interrupt controller scaffold.
++ *
++ * Physical register base is 0x18003000. Legacy SDK sources often refer to the
++ * same block through KSEG1 virtual addresses such as 0xb8003000; DT must use
++ * the physical address.
++ */
++
++#include <linux/bitops.h>
++#include <linux/io.h>
++#include <linux/irq.h>
++#include <linux/irqchip.h>
++#include <linux/irqchip/chained_irq.h>
++#include <linux/irqdomain.h>
++#include <linux/of_address.h>
++#include <linux/of_irq.h>
++#include <linux/spinlock.h>
++
++#define RTL8197F_ICTL_LINES	64
++
++#define RTL8197F_GIMR		0x00
++#define RTL8197F_GISR		0x04
++#define RTL8197F_IRR0		0x08
++#define RTL8197F_IRR1		0x0c
++#define RTL8197F_IRR2		0x10
++#define RTL8197F_IRR3		0x14
++#define RTL8197F_GIMR2		0x20
++#define RTL8197F_GISR2		0x24
++#define RTL8197F_IRR4		0x28
++#define RTL8197F_IRR5		0x2c
++#define RTL8197F_IRR6		0x30
++#define RTL8197F_IRR7		0x34
++
++struct rtl8197f_ictl {
++	void __iomem *base;
++	struct irq_domain *domain;
++	raw_spinlock_t lock;
++};
++
++static void rtl8197f_ictl_mask(struct irq_data *d)
++{
++	struct rtl8197f_ictl *ictl = irq_data_get_irq_chip_data(d);
++	unsigned long flags;
++	u32 bit = d->hwirq & 31;
++	u32 reg = d->hwirq < 32 ? RTL8197F_GIMR : RTL8197F_GIMR2;
++	u32 val;
++
++	raw_spin_lock_irqsave(&ictl->lock, flags);
++	val = readl(ictl->base + reg);
++	val &= ~BIT(bit);
++	writel(val, ictl->base + reg);
++	raw_spin_unlock_irqrestore(&ictl->lock, flags);
++}
++
++static void rtl8197f_ictl_unmask(struct irq_data *d)
++{
++	struct rtl8197f_ictl *ictl = irq_data_get_irq_chip_data(d);
++	unsigned long flags;
++	u32 bit = d->hwirq & 31;
++	u32 reg = d->hwirq < 32 ? RTL8197F_GIMR : RTL8197F_GIMR2;
++	u32 val;
++
++	raw_spin_lock_irqsave(&ictl->lock, flags);
++	val = readl(ictl->base + reg);
++	val |= BIT(bit);
++	writel(val, ictl->base + reg);
++	raw_spin_unlock_irqrestore(&ictl->lock, flags);
++}
++
++static struct irq_chip rtl8197f_ictl_chip = {
++	.name = "RTL8197F-ICTL",
++	.irq_mask = rtl8197f_ictl_mask,
++	.irq_unmask = rtl8197f_ictl_unmask,
++};
++
++static int rtl8197f_ictl_map(struct irq_domain *domain, unsigned int virq,
++				     irq_hw_number_t hwirq)
++{
++	struct rtl8197f_ictl *ictl = domain->host_data;
++
++	irq_set_chip_data(virq, ictl);
++	irq_set_chip_and_handler(virq, &rtl8197f_ictl_chip, handle_level_irq);
++	irq_set_probe(virq);
++
++	return 0;
++}
++
++static const struct irq_domain_ops rtl8197f_ictl_domain_ops = {
++	.xlate = irq_domain_xlate_onecell,
++	.map = rtl8197f_ictl_map,
++};
++
++static void rtl8197f_ictl_handle_bank(struct rtl8197f_ictl *ictl,
++				      u32 status_reg, u32 mask_reg, unsigned int base)
++{
++	u32 pending = readl(ictl->base + status_reg) & readl(ictl->base + mask_reg);
++	unsigned int bit;
++
++	for (bit = 0; bit < 32; bit++) {
++		if (pending & BIT(bit))
++			generic_handle_domain_irq(ictl->domain, base + bit);
++	}
++}
++
++static void rtl8197f_ictl_chained_handle(struct irq_desc *desc)
++{
++	struct rtl8197f_ictl *ictl = irq_desc_get_handler_data(desc);
++	struct irq_chip *chip = irq_desc_get_chip(desc);
++
++	chained_irq_enter(chip, desc);
++	rtl8197f_ictl_handle_bank(ictl, RTL8197F_GISR, RTL8197F_GIMR, 0);
++	rtl8197f_ictl_handle_bank(ictl, RTL8197F_GISR2, RTL8197F_GIMR2, 32);
++	chained_irq_exit(chip, desc);
++}
++
++static void rtl8197f_ictl_init_routing(struct rtl8197f_ictl *ictl)
++{
++	/*
++	 * TODO: Move IRR0..7 route constants into DT or confirm the common
++	 * RTL8197F reset values before enabling board-specific routing here.
++	 */
++	writel(0, ictl->base + RTL8197F_GIMR);
++	writel(0, ictl->base + RTL8197F_GIMR2);
++}
++
++static int __init rtl8197f_ictl_of_init(struct device_node *node,
++					struct device_node *parent)
++{
++	struct rtl8197f_ictl *ictl;
++	int parent_irq;
++
++	ictl = kzalloc(sizeof(*ictl), GFP_KERNEL);
++	if (!ictl)
++		return -ENOMEM;
++
++	ictl->base = of_iomap(node, 0);
++	if (!ictl->base) {
++		kfree(ictl);
++		return -ENXIO;
++	}
++
++	raw_spin_lock_init(&ictl->lock);
++	rtl8197f_ictl_init_routing(ictl);
++
++	ictl->domain = irq_domain_add_linear(node, RTL8197F_ICTL_LINES,
++						 &rtl8197f_ictl_domain_ops, ictl);
++	if (!ictl->domain) {
++		iounmap(ictl->base);
++		kfree(ictl);
++		return -ENOMEM;
++	}
++
++	parent_irq = irq_of_parse_and_map(node, 0);
++	if (!parent_irq) {
++		pr_warn("rtl8197f-ictl: no cascade parent, irqchip registered without chained handler\n");
++		return 0;
++	}
++
++	irq_set_chained_handler_and_data(parent_irq,
++					     rtl8197f_ictl_chained_handle, ictl);
++
++	return 0;
++}
++
++IRQCHIP_DECLARE(rtl8197f_ictl, "realtek,rtl8197f-ictl",
++		rtl8197f_ictl_of_init);
diff --git a/target/linux/rtl819x/patches-6.18/030-spi-add-realtek-sheipa-spi-mem-scaffold.patch b/target/linux/rtl819x/patches-6.18/030-spi-add-realtek-sheipa-spi-mem-scaffold.patch
new file mode 100644
index 0000000000000000000000000000000000000000..1b3b79af0f6c43db99084990e133ba3e7315af03
--- /dev/null
+++ b/target/linux/rtl819x/patches-6.18/030-spi-add-realtek-sheipa-spi-mem-scaffold.patch
@@ -0,0 +1,312 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: OpenWrt RTL8197F scaffold <noreply@example.invalid>
+Date: Tue, 7 Jul 2026 00:00:00 +0900
+Subject: [PATCH] spi: add Realtek Sheipa SPI memory scaffold
+
+Add a polling-first spi-mem scaffold for the Realtek Sheipa SPI controller used
+as the RTL8197F boot flash controller. JEDEC/read/erase/program sequences are
+left as TODOs until the controller contract is forward-ported from the GPLv2
+8devices reference driver.
+
+---
+ drivers/spi/Kconfig                  |  10 +++
+ drivers/spi/Makefile                 |   1 +
+ drivers/spi/spi-realtek-sheipa.c     | 145 +++++++++++++++++++++++++++++++++++
+ 3 files changed, 156 insertions(+)
+ create mode 100644 drivers/spi/spi-realtek-sheipa.c
+
+--- a/drivers/spi/Kconfig
++++ b/drivers/spi/Kconfig
+@@ -1254,6 +1254,17 @@ config SPI_REALTEK_SNAND
+ 	help
+ 	  This selects the Realtek SPI NAND Flash controller driver.
+
++config SPI_REALTEK_SHEIPA
++	tristate "Realtek Sheipa SPI flash controller scaffold"
++	depends on MACH_REALTEK_RTL819X || COMPILE_TEST
++	depends on SPI_MEM
++	help
++	  Enable a provisional spi-mem driver for the Realtek Sheipa SPI
++	  controller used by RTL8197F-class SoCs for boot SPI NOR. The initial
++	  implementation is polling-only and supports the read-only operations
++	  needed for early SPI NOR probing. Erase and page program sequences
++	  remain TODOs.
++
+ config SPI_S3C64XX
+ 	tristate "Samsung S3C64XX series type SPI"
+ 	depends on PLAT_SAMSUNG || ARCH_S5PV210 || ARCH_EXYNOS || COMPILE_TEST
+--- a/drivers/spi/Makefile
++++ b/drivers/spi/Makefile
+@@ -128,4 +128,5 @@ obj-$(CONFIG_SPI_RB4XX)			+= spi-rb4xx.o
+ obj-$(CONFIG_SPI_REALTEK_SNAND)		+= spi-realtek-rtl-snand.o
++obj-$(CONFIG_SPI_REALTEK_SHEIPA)	+= spi-realtek-sheipa.o
+ obj-$(CONFIG_SPI_RPCIF)			+= spi-rpc-if.o
+ obj-$(CONFIG_SPI_RSPI)			+= spi-rspi.o
+ obj-$(CONFIG_SPI_RZV2H_RSPI)		+= spi-rzv2h-rspi.o
+--- /dev/null
++++ b/drivers/spi/spi-realtek-sheipa.c
+@@ -0,0 +1,264 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Realtek RTL8197F "Sheipa" SPI flash controller (a Synopsys DesignWare SSI).
++ *
++ * BSP_SPIC_BASE = 0x18143000 (KSEG1 0xb8143000). The boot SPI-NOR is wired to
++ * this controller. Read sequencing follows the RTL8197F SDK
++ * (drivers/spi/sheipa/spi-sheipa.c), reimplemented from the register-level
++ * hardware facts: for a read the command + address are pushed into the TX FIFO
++ * FIRST, and only then is the controller enabled (SSIENR = 1). Enabling before
++ * loading the FIFO -- as an earlier version did -- starts the transfer with the
++ * wrong framing and wedges the controller.
++ */
++
++#include <linux/bitops.h>
++#include <linux/delay.h>
++#include <linux/io.h>
++#include <linux/minmax.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/spi/spi.h>
++#include <linux/spi/spi-mem.h>
++
++#define DW_CTRLR0	0x00
++#define DW_CTRLR1	0x04
++#define DW_SSIENR	0x08
++#define DW_SER		0x10
++#define DW_BAUDR	0x14
++#define DW_TXFLR	0x20
++#define DW_RXFLR	0x24
++#define DW_SR		0x28
++#define DW_DR0		0x60
++
++#define DW_CTRLR0_DFS_8BIT	0x7		/* data frame size = 8 bits */
++#define DW_CTRLR0_TMOD_MASK	(3 << 8)
++#define DW_CTRLR0_TMOD_TX	(1 << 8)	/* transmit only: cmd/addr/data out */
++#define DW_CTRLR0_TMOD_EEPROM	(3 << 8)	/* EEPROM read: tx cmd, then rx */
++
++#define DW_SR_BUSY	BIT(0)
++#define DW_SR_TFNF	BIT(1)			/* TX FIFO not full */
++#define DW_SR_TFE	BIT(2)			/* TX FIFO empty */
++#define DW_SR_RFNE	BIT(3)			/* RX FIFO not empty */
++
++#define DW_BAUDR_DIV	20			/* conservative SPI clock divider */
++#define DW_RX_CHUNK	32			/* max frames per transaction (FIFO-bound) */
++#define DW_POLL_US	1000000
++
++struct rtl_sheipa {
++	void __iomem *base;
++};
++
++static u32 dw_rd(struct rtl_sheipa *s, u32 reg)
++{
++	return readl(s->base + reg);
++}
++
++static void dw_wr(struct rtl_sheipa *s, u32 reg, u32 val)
++{
++	writel(val, s->base + reg);
++}
++
++static int dw_wait(struct rtl_sheipa *s, u32 mask, u32 val)
++{
++	unsigned int t = DW_POLL_US;
++
++	while (t--) {
++		if ((dw_rd(s, DW_SR) & mask) == val)
++			return 0;
++		udelay(1);
++	}
++	return -ETIMEDOUT;
++}
++
++static int rtl_sheipa_read_op(struct rtl_sheipa *s, unsigned int cs, u8 opcode,
++			      u64 addr, unsigned int addr_nbytes,
++			      unsigned int dummy_nbytes, void *buf,
++			      unsigned int len)
++{
++	u8 *rx = buf;
++	unsigned int i;
++	int ret;
++
++	if (!len || len > DW_RX_CHUNK)
++		return -EINVAL;
++
++	/* Controller must be idle and disabled to (re)configure. */
++	ret = dw_wait(s, DW_SR_BUSY, 0);
++	if (ret)
++		return ret;
++
++	dw_wr(s, DW_SSIENR, 0);
++
++	/*
++	 * EEPROM read mode + single-bit channels, preserving the DFS and SPI
++	 * mode the bootloader configured (like the SDK's set_rx_mode).
++	 */
++	dw_wr(s, DW_CTRLR0, (dw_rd(s, DW_CTRLR0) | DW_CTRLR0_TMOD_EEPROM) & 0xfff0ffff);
++	/*
++	 * This DesignWare variant loads CTRLR1 as the exact number of receive
++	 * frames (not the classic NDF = frames - 1): programming len - 1 yields
++	 * only len - 1 bytes and the final read blocks forever.
++	 */
++	dw_wr(s, DW_CTRLR1, len);
++	dw_wr(s, DW_BAUDR, DW_BAUDR_DIV);
++	dw_wr(s, DW_SER, BIT(cs));
++
++	/*
++	 * Load command/address/dummy into the TX FIFO. Each access to the data
++	 * register queues frames according to its WIDTH on this DesignWare
++	 * variant, so a byte write queues exactly one 8-bit frame -- a 32-bit
++	 * write would queue four and corrupt the framing.
++	 */
++	writeb(opcode, s->base + DW_DR0);
++	for (i = 0; i < addr_nbytes; i++)
++		writeb(addr >> (8 * (addr_nbytes - 1 - i)), s->base + DW_DR0);
++	for (i = 0; i < dummy_nbytes; i++)
++		writeb(0, s->base + DW_DR0);
++
++	/* Now start the transfer. */
++	dw_wr(s, DW_SSIENR, 1);
++
++	/* Drain the RX FIFO as the data frames arrive. */
++	for (i = 0; i < len; i++) {
++		ret = dw_wait(s, DW_SR_RFNE, DW_SR_RFNE);
++		if (ret)
++			goto out;
++		rx[i] = readb(s->base + DW_DR0);
++	}
++
++out:
++	dw_wr(s, DW_SSIENR, 0);
++	return ret;
++}
++
++/*
++ * Transmit-only transaction: command, optional address and optional data all go
++ * out on MOSI (write-enable, page program, sector/block erase). No RX. The
++ * whole frame must fit in the TX FIFO so the controller does not underrun and
++ * drop chip-select mid-command; adjust_op_size caps the data accordingly.
++ */
++static int rtl_sheipa_write_op(struct rtl_sheipa *s, unsigned int cs, u8 opcode,
++			       u64 addr, unsigned int addr_nbytes,
++			       const void *buf, unsigned int len)
++{
++	const u8 *tx = buf;
++	unsigned int i;
++	int ret;
++
++	ret = dw_wait(s, DW_SR_BUSY, 0);
++	if (ret)
++		return ret;
++
++	dw_wr(s, DW_SSIENR, 0);
++	/*
++	 * TX uses TMOD = 00 (transmit & receive), like the SDK's set_tx_mode
++	 * which just clears the TMOD bits. TMOD = 01 (transmit-only) does not
++	 * actually shift the data out on this DesignWare variant, so the flash
++	 * is never programmed and jffs2 spins forever. The RX frames clocked in
++	 * alongside the transmit are ignored (they fit the FIFO since data is
++	 * capped to 32 bytes by adjust_op_size).
++	 */
++	dw_wr(s, DW_CTRLR0,
++	      dw_rd(s, DW_CTRLR0) & 0xfff0ffff & ~DW_CTRLR0_TMOD_MASK);
++	dw_wr(s, DW_BAUDR, DW_BAUDR_DIV);
++	dw_wr(s, DW_SER, BIT(cs));
++
++	writeb(opcode, s->base + DW_DR0);
++	for (i = 0; i < addr_nbytes; i++)
++		writeb(addr >> (8 * (addr_nbytes - 1 - i)), s->base + DW_DR0);
++	for (i = 0; i < len; i++)
++		writeb(tx[i], s->base + DW_DR0);
++
++	dw_wr(s, DW_SSIENR, 1);
++
++	/* Wait until every queued frame has been shifted out. */
++	ret = dw_wait(s, DW_SR_TFE, DW_SR_TFE);
++	if (!ret)
++		ret = dw_wait(s, DW_SR_BUSY, 0);
++
++	dw_wr(s, DW_SSIENR, 0);
++	return ret;
++}
++
++static int rtl_sheipa_adjust_op_size(struct spi_mem *mem, struct spi_mem_op *op)
++{
++	if (op->data.nbytes > DW_RX_CHUNK)
++		op->data.nbytes = DW_RX_CHUNK;
++	return 0;
++}
++
++static int rtl_sheipa_exec_op(struct spi_mem *mem, const struct spi_mem_op *op)
++{
++	struct rtl_sheipa *s = spi_controller_get_devdata(mem->spi->controller);
++	unsigned int cs = spi_get_chipselect(mem->spi, 0);
++
++	if (op->cmd.buswidth != 1 || op->addr.buswidth > 1 ||
++	    op->dummy.buswidth > 1 || op->data.buswidth > 1)
++		return -EOPNOTSUPP;
++
++	if (op->data.dir == SPI_MEM_DATA_IN)
++		return rtl_sheipa_read_op(s, cs, op->cmd.opcode, op->addr.val,
++					  op->addr.nbytes, op->dummy.nbytes,
++					  op->data.buf.in, op->data.nbytes);
++
++	/* Data-out (page program) and no-data (write-enable, erase). */
++	if (op->dummy.nbytes)
++		return -EOPNOTSUPP;
++	return rtl_sheipa_write_op(s, cs, op->cmd.opcode, op->addr.val,
++				   op->addr.nbytes,
++				   op->data.dir == SPI_MEM_DATA_OUT ? op->data.buf.out : NULL,
++				   op->data.dir == SPI_MEM_DATA_OUT ? op->data.nbytes : 0);
++}
++
++static const struct spi_controller_mem_ops rtl_sheipa_mem_ops = {
++	.adjust_op_size = rtl_sheipa_adjust_op_size,
++	.exec_op = rtl_sheipa_exec_op,
++};
++
++static int rtl_sheipa_probe(struct platform_device *pdev)
++{
++	struct spi_controller *ctlr;
++	struct rtl_sheipa *s;
++
++	ctlr = devm_spi_alloc_host(&pdev->dev, sizeof(*s));
++	if (!ctlr)
++		return -ENOMEM;
++
++	platform_set_drvdata(pdev, ctlr);
++	s = spi_controller_get_devdata(ctlr);
++
++	s->base = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(s->base))
++		return PTR_ERR(s->base);
++
++	dw_wr(s, DW_SSIENR, 0);
++
++	ctlr->dev.of_node = pdev->dev.of_node;
++	ctlr->bus_num = -1;
++	ctlr->num_chipselect = 1;
++	ctlr->mode_bits = SPI_CPOL | SPI_CPHA;
++	ctlr->mem_ops = &rtl_sheipa_mem_ops;
++
++	dev_info(&pdev->dev, "Realtek RTL8197F sheipa SPI flash controller\n");
++
++	return devm_spi_register_controller(&pdev->dev, ctlr);
++}
++
++static const struct of_device_id rtl_sheipa_of_match[] = {
++	{ .compatible = "realtek,rtl8197f-sheipa-spi" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, rtl_sheipa_of_match);
++
++static struct platform_driver rtl_sheipa_driver = {
++	.probe = rtl_sheipa_probe,
++	.driver = {
++		.name = "spi-realtek-sheipa",
++		.of_match_table = rtl_sheipa_of_match,
++	},
++};
++module_platform_driver(rtl_sheipa_driver);
++
++MODULE_DESCRIPTION("Realtek RTL8197F sheipa SPI flash controller");
++MODULE_LICENSE("GPL");
diff --git a/target/linux/rtl819x/patches-6.18/040-serial-8250-of-realtek-rtl8197f-data-reg.patch b/target/linux/rtl819x/patches-6.18/040-serial-8250-of-realtek-rtl8197f-data-reg.patch
new file mode 100644
index 0000000000000000000000000000000000000000..1d8897d11f6f8ad1179156c7a896b94af6dbb9af
--- /dev/null
+++ b/target/linux/rtl819x/patches-6.18/040-serial-8250-of-realtek-rtl8197f-data-reg.patch
@@ -0,0 +1,62 @@
+--- a/drivers/tty/serial/8250/8250_of.c
++++ b/drivers/tty/serial/8250/8250_of.c
+@@ -61,6 +61,35 @@
+ 	return 0;
+ }
+
++/*
++ * Realtek RTL8197F: the RX/TX data register sits at offset 0x24 (register 9)
++ * instead of the standard 0x00. Everything else, including the DLL/DLM divisor
++ * latch at 0x00/0x04, LCR and LSR, is at the usual reg-shift-2 offset. Register
++ * 0 is therefore shared between DLL (DLAB set) and nothing at all (DLAB clear),
++ * so a stock 8250 writes characters straight into the divisor latch and garbles
++ * the console. Route offset 0 by the live DLAB bit: data goes to register 9,
++ * divisor programming still lands on the standard latch.
++ */
++#define RTL8197F_UART_DATA_REG 9
++
++static unsigned int rtl8197f_serial_in(struct uart_port *p, unsigned int offset)
++{
++	if (offset == UART_RX &&
++	    !(readl(p->membase + (UART_LCR << p->regshift)) & UART_LCR_DLAB))
++		offset = RTL8197F_UART_DATA_REG;
++
++	return readl(p->membase + (offset << p->regshift));
++}
++
++static void rtl8197f_serial_out(struct uart_port *p, unsigned int offset, u32 value)
++{
++	if (offset == UART_TX &&
++	    !(readl(p->membase + (UART_LCR << p->regshift)) & UART_LCR_DLAB))
++		offset = RTL8197F_UART_DATA_REG;
++
++	writel(value, p->membase + (offset << p->regshift));
++}
++
+ static inline struct of_serial_info *clk_nb_to_info(struct notifier_block *nb)
+ {
+ 	return container_of(nb, struct of_serial_info, clk_notifier);
+@@ -150,6 +179,15 @@
+ 	if (of_device_is_compatible(np, "mrvl,mmp-uart"))
+ 		port->regshift = 2;
+
++	/*
++	 * These are applied after serial8250_set_defaults() in
++	 * serial8250_register_8250_port(), so they survive set_io_from_upio().
++	 */
++	if (of_device_is_compatible(np, "realtek,rtl8197f-uart")) {
++		port->serial_in = rtl8197f_serial_in;
++		port->serial_out = rtl8197f_serial_out;
++	}
++
+ 	info->rst = devm_reset_control_get_optional_shared(&ofdev->dev, NULL);
+ 	if (IS_ERR(info->rst)) {
+ 		ret = PTR_ERR(info->rst);
+@@ -353,6 +391,7 @@
+ 	{ .compatible = "ti,da830-uart", .data = (void *)PORT_DA830, },
+ 	{ .compatible = "nuvoton,wpcm450-uart", .data = (void *)PORT_NPCM, },
+ 	{ .compatible = "nuvoton,npcm750-uart", .data = (void *)PORT_NPCM, },
++	{ .compatible = "realtek,rtl8197f-uart", .data = (void *)PORT_16550A, },
+ 	{ /* end of list */ },
+ };
+ MODULE_DEVICE_TABLE(of, of_platform_serial_table);
diff --git a/target/linux/rtl819x/patches-6.18/041-serial-8250-early-realtek-rtl8197f-earlycon.patch b/target/linux/rtl819x/patches-6.18/041-serial-8250-early-realtek-rtl8197f-earlycon.patch
new file mode 100644
index 0000000000000000000000000000000000000000..d0c26bc40fa6c26562a954629e92128dc2cd7704
--- /dev/null
+++ b/target/linux/rtl819x/patches-6.18/041-serial-8250-early-realtek-rtl8197f-earlycon.patch
@@ -0,0 +1,50 @@
+--- a/drivers/tty/serial/8250/8250_early.c
++++ b/drivers/tty/serial/8250/8250_early.c
+@@ -170,6 +170,47 @@
+ 	device->con->read = early_serial8250_read;
+ 	return 0;
+ }
++/*
++ * Realtek RTL8197F: the RX/TX data register is at 0x24 (register 9), not the
++ * standard 0x00. init_port() only touches control/latch registers, which are
++ * standard, so it works unchanged; only the character output has to target the
++ * relocated data register. DLAB is always clear while transmitting, so no
++ * disambiguation is needed here.
++ */
++static void __init rtl8197f_early_putc(struct uart_port *port, unsigned char c)
++{
++	unsigned int status;
++
++	writel(c, port->membase + (9 << port->regshift));
++	for (;;) {
++		status = serial8250_early_in(port, UART_LSR);
++		if (uart_lsr_tx_empty(status))
++			break;
++		cpu_relax();
++	}
++}
++
++static void __init rtl8197f_early_write(struct console *console,
++				       const char *s, unsigned int count)
++{
++	struct earlycon_device *device = console->data;
++
++	uart_console_write(&device->port, s, count, rtl8197f_early_putc);
++}
++
++static int __init rtl8197f_early_setup(struct earlycon_device *device,
++				       const char *options)
++{
++	int ret = early_serial8250_setup(device, options);
++
++	if (ret)
++		return ret;
++
++	device->con->write = rtl8197f_early_write;
++	return 0;
++}
++OF_EARLYCON_DECLARE(rtl8197f, "realtek,rtl8197f-uart", rtl8197f_early_setup);
++
+ EARLYCON_DECLARE(uart8250, early_serial8250_setup);
+ EARLYCON_DECLARE(uart, early_serial8250_setup);
+ OF_EARLYCON_DECLARE(ns16550, "ns16550", early_serial8250_setup);
