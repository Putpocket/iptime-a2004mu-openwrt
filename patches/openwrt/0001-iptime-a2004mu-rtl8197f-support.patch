diff --git a/target/linux/rtl819x/patches-6.18/060-net-dsa-rtl8-4-pad-short-frames.patch b/target/linux/rtl819x/patches-6.18/060-net-dsa-rtl8-4-pad-short-frames.patch
new file mode 100644
index 0000000000000000000000000000000000000000..65dbbdfbc71d31ec669ba0526621d2b23858cd46
--- /dev/null
+++ b/target/linux/rtl819x/patches-6.18/060-net-dsa-rtl8-4-pad-short-frames.patch
@@ -0,0 +1,16 @@
+--- a/net/dsa/tag_rtl8_4.c
++++ b/net/dsa/tag_rtl8_4.c
+@@ -129,6 +129,13 @@ static void rtl8_4_write_tag(struct sk_bu
+ static struct sk_buff *rtl8_4_tag_xmit(struct sk_buff *skb,
+ 				       struct net_device *dev)
+ {
++	/* The switch removes the 8-byte tag before transmitting the frame.
++	 * Pad the untagged frame first so it remains at least ETH_ZLEN bytes
++	 * after the tag is removed.
++	 */
++	if (unlikely(__skb_put_padto(skb, ETH_ZLEN, false)))
++		return NULL;
++
+ 	skb_push(skb, RTL8_4_TAG_LEN);
+
+ 	dsa_alloc_etype_header(skb, RTL8_4_TAG_LEN);
diff --git a/target/linux/rtl819x/patches-6.18/061-net-dsa-realtek-rtl8197f-hw-cputag.patch b/target/linux/rtl819x/patches-6.18/061-net-dsa-realtek-rtl8197f-hw-cputag.patch
new file mode 100644
index 0000000000000000000000000000000000000000..913cb445bc849ccd8bed094bba9f649349622a8f
--- /dev/null
+++ b/target/linux/rtl819x/patches-6.18/061-net-dsa-realtek-rtl8197f-hw-cputag.patch
@@ -0,0 +1,28 @@
+From: OpenWrt RTL819x porting
+Subject: [PATCH] net: dsa: realtek: use RTL8197F hardware CPU-tag format
+
+The RTL8197F MAC connected to the RTL8367RB-VB has hardware which translates
+the switch's native 4-byte CPU tag to and from swNic descriptor port metadata.
+Keep reporting RTL8_4 to DSA as the in-kernel port-selection format, but put
+the external switch into the vendor SDK's 4-byte wire format.
+
+--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
++++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
+@@ -2341,7 +2341,7 @@ static int rtl8365mb_change_tag_protocol(
+
+ 	switch (proto) {
+ 	case DSA_TAG_PROTO_RTL8_4:
+-		cpu->format = RTL8365MB_CPU_FORMAT_8BYTES;
++		cpu->format = RTL8365MB_CPU_FORMAT_4BYTES;
+ 		cpu->position = RTL8365MB_CPU_POS_AFTER_SA;
+ 		break;
+ 	case DSA_TAG_PROTO_RTL8_4T:
+@@ -2652,7 +2652,7 @@ static int rtl8365mb_detect(struct realte
+ 	mb->cpu.insert = RTL8365MB_CPU_INSERT_TO_ALL;
+ 	mb->cpu.position = RTL8365MB_CPU_POS_AFTER_SA;
+ 	mb->cpu.rx_length = RTL8365MB_CPU_RXLEN_64BYTES;
+-	mb->cpu.format = RTL8365MB_CPU_FORMAT_8BYTES;
++	mb->cpu.format = RTL8365MB_CPU_FORMAT_4BYTES;
+
+ 	return 0;
+ }
